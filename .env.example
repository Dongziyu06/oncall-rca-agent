# 复制本文件为 .env 后填入真实值
# cp .env.example .env

# 各 Agent 模型（按任务复杂度分级）
LLM_MODEL_ROUTER=qwen3.6-flash
LLM_MODEL_FOLLOWUP=deepseek-v4.1-flash
LLM_MODEL_SUMMARIZE=deepseek-v4-pro
LLM_MODEL=qwen3.8-flash

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
KUBECONFIG=
# 实验室自签证书设 false；生产建议 true
K8S_VERIFY_SSL=false
CHROMA_PERSIST_DIR=.chroma
